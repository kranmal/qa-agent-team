{
  "name": "qa-suite",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright + Vitest QA suite with step screenshots, coverage tracking, PDF reports and Zephyr Scale export",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "test:e2e": "cross-env PLAYWRIGHT_JSON_OUTPUT_NAME=artifacts/results-e2e.json playwright test --project=e2e",
    "test:api": "cross-env PLAYWRIGHT_JSON_OUTPUT_NAME=artifacts/results-api.json playwright test --project=api",
    "test:a11y": "cross-env PLAYWRIGHT_JSON_OUTPUT_NAME=artifacts/results-a11y.json playwright test --project=a11y",
    "test:unit": "vitest run --coverage --passWithNoTests",
    "test:all": "tsx scripts/run-all.ts",
    "coverage:check": "tsx scripts/coverage-check.ts",
    "scan:changes": "tsx scripts/scan-changes.ts",
    "report": "tsx scripts/report.ts functional",
    "report:a11y": "tsx scripts/report.ts a11y",
    "report:bugs": "tsx scripts/report.ts bugs",
    "zephyr:export": "tsx scripts/export-zephyr.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
